// RIFT_SCAN_FIXTURE POSIX-THIN-LINES
// RIFT_SCAN_SCOPE yes
int Thick(int a) {
  int b = a;
  b = b + 1;
  b = b + 2;
  b = b + 3;
  b = b + 4;
  b = b + 5;
  b = b + 6;
  b = b + 7;
  b = b + 8;
  b = b + 9;
  b = b + 10;
  b = b + 11;
  b = b + 12;
  b = b + 13;
  b = b + 14;
  b = b + 15;
  b = b + 16;
  return b;
}

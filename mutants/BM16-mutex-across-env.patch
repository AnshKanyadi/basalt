# id: BM16-mutex-across-env
# blinds: the DB mutex never being held across an Env call
# covering-lane: cpp-test
# expect: killed
# control-lane: cpp-build
# expect-control: alive
#
# The catalogue's BM16, and it is SECTION 0.1 PRINCIPLE 1 MADE CONCRETE: a
# ruling that constrains a design is responsible for the failure modes it opens.
#
# The lock ruling (B1-D6c) is correct and removes a whole class of
# unreproducible bug. It also opens exactly one new failure: a Sync holding the
# DB mutex across an fsync blocks every reader for the fsync's duration. That
# defect is a CONSEQUENCE of the ruling, it is invisible to every correctness
# test -- this patch changes no behaviour anyone can observe from outside -- and
# it would have surfaced at B5 as benchmarks that looked inexplicably bad.
#
# The patch is also the shape a real edit takes: someone widens a lock's scope
# to "simplify" a function. DbLock exists so that widening the lock widens the
# guard with it; a separate marker would have been left behind by exactly this
# change.
--- a/engine-cpp/src/wal/wal.cc	2026-08-24 21:15:11
+++ b/engine-cpp/src/wal/wal.cc	2026-08-24 21:15:11
@@ -104,8 +104,8 @@
 Status Wal::Sync(SeqNum* watermark) {
   std::vector<std::string> batch;
   SeqNum high = 0;
+  DbLock lock(mu_);  // BM16: held across the Append and the fsync below
   {
-    DbLock lock(mu_);
     if (closed_) return Status::InvalidArgument("Sync after Close");
     if (buffered_.empty()) {
       *watermark = durable_;
@@ -133,10 +133,7 @@
 
   // AND ONLY NOW. The watermark advances when, and only when, the Sync covering
   // this group's GROUP_END has returned success.
-  {
-    DbLock lock(mu_);
-    durable_ = high;
-  }
+  durable_ = high;  // BM16: already holding the lock
   *watermark = high;
   return Status::Ok();
 }
